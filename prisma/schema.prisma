generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite dev: enums stored as String. PostgreSQL prod: migrate to native enums.
// Plan values: FREE | STARTER | GROWTH | ENTERPRISE
// Role values: SEEKER | EMPLOYER | ADMIN
// JobStatus values: DRAFT | ACTIVE | EXPIRED | PAUSED | DELETED
// FlexTag values: SCHOOL_HOURS | TERM_TIME | FOUR_DAY_WEEK | JOB_SHARE | ASYNC | COMPRESSED_HOURS | FLEXIBLE_START_FINISH
// ContractType values: PERMANENT | FTC | CONTRACT
// AppStatus values: PENDING | REVIEWED | SHORTLISTED | REJECTED

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  hashedPassword String?
  role           String    @default("SEEKER") // SEEKER | EMPLOYER | ADMIN
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  company      Company?
  applications Application[]
  savedJobs    SavedJob[]
}

model Company {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  name                 String
  slug                 String    @unique
  logo                 String?
  description          String?
  website              String?
  parentFriendlyBadge  Boolean   @default(false)
  badgeVerifiedAt      DateTime?
  plan                 String    @default("FREE") // FREE | STARTER | GROWTH | ENTERPRISE
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   // active | past_due | canceled
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  jobs Job[]
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  title           String
  slug            String    @unique
  description     String
  requirements    String?
  salaryMin       Int?
  salaryMax       Int?
  location        String?
  remote          Boolean   @default(false)
  partTime        Boolean   @default(false)
  featured        Boolean   @default(false)
  featuredUntil   DateTime?
  status          String    @default("DRAFT") // DRAFT | ACTIVE | EXPIRED | PAUSED | DELETED
  closingDate     DateTime?
  sector            String?
  applyUrl          String?
  returnerFriendly  Boolean   @default(false)
  contractType      String?   // PERMANENT | FTC | CONTRACT
  officeDaysPerWeek Int?      // 0-5; 0 = fully remote, null = not specified
  stripePaymentId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tags         JobTag[]
  applications Application[]
  savedBy      SavedJob[]

  @@index([status, featured, createdAt])
  @@index([companyId])
  @@index([sector])
  @@index([salaryMin])
  @@index([remote])
  @@index([partTime])
  @@index([returnerFriendly])
  @@index([contractType])
  @@index([officeDaysPerWeek])
}

model JobTag {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   String // SCHOOL_HOURS | TERM_TIME | FOUR_DAY_WEEK | JOB_SHARE | ASYNC | COMPRESSED_HOURS

  @@index([jobId])
  @@index([tag])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  coverLetter String?
  cvUrl       String?
  status      String   @default("PENDING") // PENDING | REVIEWED | SHORTLISTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([jobId, userId])
}

model SavedJob {
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id])
  job       Job      @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
